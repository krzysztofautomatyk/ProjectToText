{
  "$schema": "https://v2.tauri.app/schema.json",
  "productName": "ptt",
  "version": "0.2.4",
  "identifier": "com.projecttotext.ptt",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ptt — ProjectToText",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Pack any project into LLM-ready text, respecting .gitignore",
    "longDescription": "ProjectToText (ptt) is a git-native desktop app that turns folders into high-quality XML/Markdown/JSON context for LLMs. It respects .gitignore exactly like Git and supports .pttignore for extra exclusions."
  },
  "plugins": {
    "dialog": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMDc5RTg5Nzk5NTg2MTUKUldRVmhwVjVpWjRIWVZBZU9RcVhMSFN6V3ZSV0FxQXoxODc0NGVHeWl1ZFN1RW1YMVl6TEQzdXgK",
      "endpoints": [
        "https://github.com/krzysztofautomatyk/ProjectToText/releases/latest/download/latest.json"
      ]
    }
  }
}
