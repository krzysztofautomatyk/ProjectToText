# Exclusions for LLM packing of this repository. Same syntax as .gitignore.
#
# Tauri auto-generated ACL schemas (large JSON boilerplate)
gen/schemas/**

# Lockfiles (high token cost, low LLM value unless debugging dependencies)
Cargo.lock
ui/package-lock.json
package-lock.json
pnpm-lock.yaml
yarn.lock

# Marketing binary/SVG screenshot assets
docs/screenshots/**

# Packed context outputs
project.xml
project.md
project.json
project.txt
context.xml
context.md
context.json
context.txt

# Other examples you may want in your own repos:
# *.log
# *.min.js
# **/fixtures/large/**
# **/*.snap
